PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/codetrail
JWT_SECRET=replace_with_a_secure_secret
GOOGLE_CLIENT_ID=replace_with_google_client_id
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Use the Piston deployment provided by your team.
PISTON_API_URL=https://your-piston-host/api/v2/piston/execute
PISTON_API_KEY=replace_with_piston_api_key

# CodeTrail AI Assistant & LLM Configuration (Manushri)
# Google Gemini API Configuration (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI / OpenAI-Compatible Alternative (Optional)
OPENAI_API_KEY=your_openai_api_key_here
# Primary model, or comma-separated list tried in order on limit/unavailable/network errors (401/403 auth errors are not retried across models)
OPENAI_MODEL=gpt-4o-mini
# Additional fallback models (comma or newline separated). Optional; merged after OPENAI_MODEL.
# OPENAI_FALLBACK_MODELS=kilo-auto/free,cohere/north-mini-code:free,nvidia/nemotron-3.5-lightning:free
# AI_API_BASE_URL=https://api.groq.com/openai/v1
#
# Kilo AI Gateway free-model example (restart backend after changes):
# AI_API_BASE_URL=https://ai-gateway.kilo.ai/api/v1
# OPENAI_API_KEY=your_kilo_api_key
# OPENAI_MODEL=kilo-auto/free,cohere/north-mini-code:free,nvidia/nemotron-3.5-lightning:free,baidu/ernie-5.5-flash-preview:free
# GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=
